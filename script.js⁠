/**
 * Core Interactive Rendering Function
 * Trigger: Executed when user modifies the selection in the Dismissal Time dropdown
 */
function updateProgramView() {
    const selectEl = document.getElementById('dismissal-time');
    const container = document.getElementById('pricing-container');
    
    // Defensive Guard: Prevents script exceptions from hanging in case of DOM manipulation issues
    if (!selectEl || !container) {
        console.warn("UMC System Error: Target DOM elements not found.");
        return;
    }

    const selectedTier = selectEl.value;
    if (!selectedTier) return;

    const data = DATA_MATRIX[selectedTier];
    if (!data) {
        container.innerHTML = `<div class="placeholder-text">No matching plan found for this time slot. Please contact the Admissions Director.</div>`;
        return;
    }

    // Execute Actuarial Layout Rendering
    if (data.type === 'dual') {
        container.innerHTML = `
            <div class="price-card option-one">
                <h3>🟢 Option 1: Core Mandarin Track (Mandarin Class ONLY)</h3>
                <div class="price">${data.opt1_price}<span> / Month</span></div>
                <p><strong>Dismissal Time:</strong> ${PROGRAM_CONFIG.DEFAULT_LEAVE_TIME_SHORT}</p>
                <p><strong>Program Window:</strong> ${data.opt1_text}</p>
                <ul>
                    <li>Dedicated escort teachers secure safe student pickup right at the public school gates (K-5 all grades).</li>
                    <li>Mid-session energy recharge and balanced indoor/outdoor recess transitions.</li>
                    <li><strong>📈 Core Value:</strong> Includes a 1-hour daily immersive Mandarin core class, carrying the **highest academic, faculty, and R&D costs**.</li>
                    <li><strong>✨ Assessment Guarantee:</strong> Free professional Mandarin Assessment on Day 1; students are accurately placed into leveled instruction groups starting Day 2.</li>
                </ul>
            </div>
            
            <div class="price-card option-two">
                <h3>🔵 Option 2: Extended Care, Homework & Arts Plan (Mandarin + Extension)</h3>
                <div class="price">${data.opt2_price}<span> / Month</span></div>
                <p><strong>Dismissal Time:</strong> ${PROGRAM_CONFIG.DEFAULT_LEAVE_TIME_LONG}</p>
                <p><strong>Program Window:</strong> ${data.opt2_text}</p>
                <ul>
                    <li>Includes all safe gateway pickup services and the **high-value leveled Mandarin core class** from Option 1.</li>
                    <li><strong>🎨 Creative Fine Arts & Crafts:</strong> Diversified arts, crafts, origami, and cultural projects guided by specialized instructors (all-inclusive premium material fees).</li>
                    <li><strong>📝 Multi-Grade Homework Supervision:</strong> High-standard tutoring, inspection, thorough correction, and individual Q&A for school assignments across grades K-5.</li>
                    <li><strong>🎁 Premium Exclusive:</strong> Fully includes daily complimentary nutritious supper (Free Supper) and stress-free evening childcare supervision.</li>
                </ul>
            </div>
        `;
    } else {
        container.innerHTML = `
            <div class="price-card option-elite" style="max-width: 650px; margin: 0 auto;">
                <h3>🟠 Late Dismissal All-Inclusive Elite Plan</h3>
                <div class="price">${data.price}<span> / Month</span></div>
                <p><strong>Dismissal Time:</strong> ${PROGRAM_CONFIG.DEFAULT_LEAVE_TIME_LONG}</p>
                <p><strong>Program Window:</strong> ${data.text}</p>
                <div class="value-badge">💎 Premium Value Density: Core Mandarin instruction takes up 36% - 50% of the entire program window!</div>
                <p style="margin-top: 15px;">Due to later public school dismissal schedules, basic childcare buffer periods are naturally streamlined. This plan eliminates fluff and focuses resources squarely on high-value learning milestones and core dining needs:</p>
                <ul>
                    <li>Tight, seamless safe gateway pickup at school dismissal (K-5 all grades).</li>
                    <li><strong>📈 Core Academic Engine:</strong> Complimentary Day 1 Mandarin diagnostic assessment, followed by a daily 1-hour complete, high-investment systematic leveled immersion program.</li>
                    <li><strong>🎨 Fine Arts & Homework Tutoring:</strong> High-efficiency grade-appropriate homework supervision, creative handicrafts, and cultural painting/paper-cutting projects.</li>
                    <li><strong>🎁 Premium Exclusive:</strong> Fully covers a daily hot nutritious supper (Free Supper). Parents can pick up well-fed children with all public school homework completed with absolute piece of mind.</li>
                </ul>
            </div>
        `;
    }
}
