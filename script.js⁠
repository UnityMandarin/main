function renderUmcDynamicPrice() {
    const tierEl = document.getElementById('dismissalTier');
    const onsiteEl = document.getElementById('typeOnsite');
    const displayArea = document.getElementById('dynamicPriceDisplay');
    
    // Defensive check to avoid runtime errors if elements haven't loaded yet
    if (!tierEl || !onsiteEl || !displayArea) return;

    const tier = tierEl.value;
    const isOnsite = onsiteEl.checked;
    
    const currentTrack = isOnsite ? umcPriceMatrix.onsite : umcPriceMatrix.offsite;
    const currentData = currentTrack[tier];
    
    if (!currentData) return;
    
    let htmlContent = '';
    let complianceNoticeTemplate = '';
    
    if (isOnsite) {
        complianceNoticeTemplate = `
            <div class="card-onsite-notice-tag">
                ⚠️ 须经小学校长与托管Lead Agent审批准入 / Subject to Principal & Lead Agent Approval. 
                <a href="https://your-interest-form-link.com" target="_blank" style="color: #b45309; font-weight:700; text-decoration:underline;">
                    点击进入意向申请 / Click to Apply
                </a>
            </div>
        `;
    }

    const feesTemplate = `
        <div class="mandatory-fees-row" style="font-size:0.78rem; line-height:1.4; margin-top: 10px; border-top: 1px dashed #ddd; padding-top: 8px; color:#5A6B7C;">
            <div>📝 注册费: $80/年 (不可退) | Registration: $80/yr (Non-refundable)</div>
            <div>📚 书本材料费: $80/年 | Book & Materials: $80/yr</div>
        </div>
        <div class="brightwheel-tag" style="margin-top:5px; font-weight:bold; color:#0284c7; font-size:0.8rem;">📱 Powered by Brightwheel System</div>
        ${complianceNoticeTemplate}
    `;

    if (currentData.type === 'triple') {
        htmlContent = `
            <div class="dynamic-price-triple-grid">
                <div class="price-sub-card">
                    <span class="plan-badge">选项一：4点接 / Option 1 (4 PM)</span>
                    <div class="big-price">${currentData.opt1}<small>/月费 Month</small></div>
                    <p class="time-info">⏰ 作息 / Schedule：<br><strong>${currentData.text1_zh}</strong><br><small style="color:#666;">${currentData.text1_en}</small></p>
                    <p class="academic-promise focus-chinese">⭐ <strong>首要覆盖 / Core focus：</strong>1小时分级中文核心课（高效纯课时，Brightwheel 安全签到）。<br>
                    <small style="display:block; margin-top:2px; font-style:italic; color:#777;">1-hour high-efficiency leveled Mandarin core class block.</small></p>
                    ${feesTemplate}
                </div>
                
                <div class="price-sub-card">
                    <span class="plan-badge badge-blue-tag">选项二：5:15接 / Option 2 (5:15 PM)</span>
                    <div class="big-price">${currentData.opt2}<small>/月费 Month</small></div>
                    <p class="time-info">⏰ 作息 / Schedule：<br><strong>${currentData.text2_zh}</strong><br><small style="color:#666;">${currentData.text2_en}</small></p>
                    <p class="academic-promise">📐 <strong>多维拓展 / Multi-Track：</strong>1小时中文核心课 + 学校家庭作业（含中/英/数学）日常辅导答疑 + 适当融入趣味才艺体验与能量点心。<br>
                    <small style="display:block; margin-top:2px; font-style:italic; color:#777;">1-hr Mandarin core + academic homework coaching + enrichment culture experiences + snacks.</small></p>
                    ${feesTemplate}
                </div>
                
                <div class="price-sub-card primary-sub-card">
                    <span class="plan-badge badge-gold">选项三：6点接 / Option 3 (6 PM)</span>
                    <div class="big-price">${currentData.opt3}<small>/月费 Month</small></div>
                    <p class="time-info">⏰ 作息 / Schedule：<br><strong>${currentData.text3_zh}</strong><br><small style="color:#666;">${currentData.text3_en}</small></p>
                    <p class="academic-promise">🥋 <strong>全维长托 / Premium Extended：</strong>1小时中文核心课 + 学校功课辅导答疑（包含数学难题启发） + 丰富中华武术/手工绘画轮换体验 + 能量点心 + 延时看护。<br>
                    <small style="display:block; margin-top:2px; font-style:italic; color:#777;">Full immersive experience: 1-hr core class + multi-subject homework support + rotating Martial Arts/Fine Arts tracks + energy snacks + full extended care.</small></p>
                    ${feesTemplate}
                </div>
            </div>
        `;
    } else {
        htmlContent = `
            <div class="dynamic-price-single-card">
                <span class="plan-badge badge-exclusive">全包长托专属计划 / Single Extended Care Plan</span>
                <div class="big-price">${currentData.price}<small>/月费 Month</small></div>
                <p class="time-info">⏰ 运行作息 / Running Schedule：<br><strong>${currentData.text_zh}</strong><br><small style="color:#666; display:block; margin-top:4px;">${currentData.text_en}</small></p>
                <p class="academic-promise" style="margin-bottom:10px;">🥋 <strong>全维交付 / Total Delivery：</strong>1小时核心中文课 + 中英数学业功课日常辅导答疑 + 适当穿插手工/绘画/武术丰富体验 + 能量点心。全流程覆盖 Brightwheel 安全管家服务。<br>
                <small style="display:block; margin-top:2px; font-style:italic; color:#666;">1-hr core immersion block + full academic guidance + specialized cultural arts rotation + daily snack supply. Fully managed under the premium Brightwheel safety umbrella.</small></p>
                ${feesTemplate}
            </div>
        `;
    }
    
    displayArea.innerHTML = htmlContent;
}

// Initial Hooking of DOM Events
document.addEventListener('DOMContentLoaded', () => {
    renderUmcDynamicPrice();
    
    const selectTier = document.getElementById('dismissalTier');
    const radioOnsite = document.getElementById('typeOnsite');
    const radioOffsite = document.getElementById('typeOffsite');

    if (selectTier) selectTier.addEventListener('change', renderUmcDynamicPrice);
    if (radioOnsite) radioOnsite.addEventListener('change', renderUmcDynamicPrice);
    if (radioOffsite) radioOffsite.addEventListener('change', renderUmcDynamicPrice);
});
