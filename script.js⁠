/**
 * 🔒 Operational Core: Recursive Deep Freeze Implementation
 * Prevents client-side runtime injection or tampered data modifications to matrix configurations.
 */
function deepFreezeMatrix(obj) {
    Object.keys(obj).forEach(name => {
        let prop = obj[name];
        if (typeof prop === 'object' && prop !== null) {
            deepFreezeMatrix(prop);
        }
    });
    return Object.freeze(obj);
}
deepFreezeMatrix(umcPriceMatrix);

